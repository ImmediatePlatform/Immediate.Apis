<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<IsPackable>true</IsPackable>
	<IncludeBuildOutput>false</IncludeBuildOutput>

	<EnablePackageValidation>true</EnablePackageValidation>
	<PackageValidationBaselineVersion>6.0.0</PackageValidationBaselineVersion>
  </PropertyGroup>

  <PropertyGroup Label="Nuget">
	<Title>Immediate.Apis</Title>
	<Description>A source generator to bind Immediate.Handlers handlers to minimal APIs.</Description>

	<Authors>Immediate.Apis Developers</Authors>
	<Copyright>© 2024-2026 Immediate.Apis Developers</Copyright>

	<PackageLicenseExpression>MIT</PackageLicenseExpression>
	<PackageReadmeFile>readme.md</PackageReadmeFile>
	<PackageTags>csharp-sourcegenerator;mediator;mediator-pattern;minimal-apis</PackageTags>

	<PublishRepositoryUrl>true</PublishRepositoryUrl>
	<RepositoryUrl>https://github.com/ImmediatePlatform/Immediate.Apis</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
	<PackageReference Include="Immediate.Handlers" />
  </ItemGroup>

  <!--
	This ensures the library will be packaged as a source generator when we use `dotnet pack`
	-->
  <ItemGroup>
	<None Include="../../readme.md" Pack="true" PackagePath="/" />

	<!-- IH.Shared -->
	<TfmSpecificPackageFile
	  Include="../Immediate.Apis.Shared/bin/$(Configuration)/$(TargetFramework)/Immediate.Apis.Shared.dll"
	  Pack="true"
	  PackagePath="lib/$(TargetFramework)" />

	<TfmSpecificPackageFile
	  Include="../Immediate.Apis.Shared/bin/$(Configuration)/$(TargetFramework)/Immediate.Apis.Shared.xml"
	  Pack="true"
	  PackagePath="lib/$(TargetFramework)" />
  </ItemGroup>

  <ItemGroup>
	<None
	  Include="../Immediate.Apis.Analyzers/bin/$(Configuration)/roslyn4.8/Immediate.Apis.Analyzers.dll"
	  Pack="true"
	  PackagePath="analyzers/dotnet/roslyn4.8/cs" />

	<None
	  Include="../Immediate.Apis.CodeFixes/bin/$(Configuration)/roslyn4.8/Immediate.Apis.CodeFixes.dll"
	  Pack="true"
	  PackagePath="analyzers/dotnet/roslyn4.8/cs" />

	<None
	  Include="../Immediate.Apis.Generators/bin/$(Configuration)/roslyn4.8/Immediate.Apis.Generators.dll"
	  Pack="true"
	  PackagePath="analyzers/dotnet/roslyn4.8/cs" />
  </ItemGroup>

  <ItemGroup>
	<None
	  Include="../Immediate.Apis.Analyzers/bin/$(Configuration)/roslyn5.0/Immediate.Apis.Analyzers.dll"
	  Pack="true"
	  PackagePath="analyzers/dotnet/roslyn5.0/cs" />

	<None
	  Include="../Immediate.Apis.CodeFixes/bin/$(Configuration)/roslyn5.0/Immediate.Apis.CodeFixes.dll"
	  Pack="true"
	  PackagePath="analyzers/dotnet/roslyn5.0/cs" />

	<None
	  Include="../Immediate.Apis.Generators/bin/$(Configuration)/roslyn5.0/Immediate.Apis.Generators.dll"
	  Pack="true"
	  PackagePath="analyzers/dotnet/roslyn5.0/cs" />

	<TfmSpecificPackageFile
	  Condition=" '$(TargetFramework)' == 'net8.0' "
	  Include="$(PkgScriban)/lib/net8.0/Scriban.dll"
	  Pack="true"
	  PackagePath="analyzers/dotnet/roslyn5.0/cs" />
  </ItemGroup>

  <ItemGroup>
	<None
	  Include="../Immediate.Apis.Analyzers/bin/$(Configuration)/roslyn5.9/Immediate.Apis.Analyzers.dll"
	  Pack="true"
	  PackagePath="analyzers/dotnet/roslyn5.9/cs" />

	<None
	  Include="../Immediate.Apis.CodeFixes/bin/$(Configuration)/roslyn5.9/Immediate.Apis.CodeFixes.dll"
	  Pack="true"
	  PackagePath="analyzers/dotnet/roslyn5.9/cs" />

	<None
	  Include="../Immediate.Apis.Generators/bin/$(Configuration)/roslyn5.9/Immediate.Apis.Generators.dll"
	  Pack="true"
	  PackagePath="analyzers/dotnet/roslyn5.9/cs" />

	<TfmSpecificPackageFile
	  Condition=" '$(TargetFramework)' == 'net8.0' "
	  Include="$(PkgScriban)/lib/net8.0/Scriban.dll"
	  Pack="true"
	  PackagePath="analyzers/dotnet/roslyn5.9/cs" />
  </ItemGroup>

  <ItemGroup>
	<PackageReference Include="Scriban" PrivateAssets="all" GeneratePathProperty="true" />
  </ItemGroup>

  <ItemGroup>
	<ProjectReference Include="../Immediate.Apis.Shared/Immediate.Apis.Shared.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <PropertyGroup>
	<RoslynVersion Condition=" '$(TargetFramework)' == 'net8.0' ">roslyn4.8</RoslynVersion>
	<RoslynVersion Condition=" '$(TargetFramework)' == 'net10.0' ">roslyn5.0</RoslynVersion>
	<RoslynVersion Condition=" '$(TargetFramework)' == 'net11.0' ">roslyn5.9</RoslynVersion>
  </PropertyGroup>

  <ItemGroup>
	<ProjectReference Include="../../src/Immediate.Apis.Analyzers/Immediate.Apis.Analyzers.csproj" ReferenceOutputAssembly="false">
	  <SetTargetFramework>TargetFramework=$(RoslynVersion)</SetTargetFramework>
	</ProjectReference>

	<ProjectReference Include="../../src/Immediate.Apis.CodeFixes/Immediate.Apis.CodeFixes.csproj" ReferenceOutputAssembly="false">
	  <SetTargetFramework>TargetFramework=$(RoslynVersion)</SetTargetFramework>
	</ProjectReference>

	<ProjectReference Include="../../src/Immediate.Apis.Generators/Immediate.Apis.Generators.csproj" ReferenceOutputAssembly="false">
	  <SetTargetFramework>TargetFramework=$(RoslynVersion)</SetTargetFramework>
	</ProjectReference>
  </ItemGroup>

</Project>
